# Copy to .env for local runs and docker compose (or .env.production when
# NODE_ENV=production). Every value below is a placeholder.

PORT=3000

# PostgreSQL. docker compose also reads POSTGRES_USER, POSTGRES_PASSWORD,
# POSTGRES_DB and POSTGRES_PORT from this file to create the database.
# TypeORM synchronises the schema on start (synchronize: true).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lms

# Signs login and email-verification tokens. Required: the app refuses to start without it.
JWT_SECRET=replace-with-a-long-random-string

# RabbitMQ queue for verification emails.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Redis settings for the cache module.
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP server for verification emails (for example a Mailtrap sandbox).
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=replace-me
MAIL_PASS=replace-me
